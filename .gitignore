# Local .terraform directories
**/.terraform/*

# State files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files with secrets (keep the example)
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backend partial-config files
backend.hcl

# Plan output files
*.tfplan
*.plan

# CLI configuration files
.terraformrc
terraform.rc
